PORT=3000
ADMIN_EMAIL=admin@printqr.local
ADMIN_PASSWORD=admin123

# Razorpay India Payment Gateway (Test Mode)
# Get your API keys from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Webhook Secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Razorpay Route Marketplace Configuration
# Platform fee percentage kept by platform (e.g. 10 = 10% platform fee, 90% to seller UPI)
# NOTE: VPA Settlements must be enabled by Razorpay support for your account first.
PLATFORM_FEE_PERCENT=10
